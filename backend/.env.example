# Sao chép thành file .env (đã nằm trong .gitignore) rồi đổi giá trị.
# Các giá trị dưới đây CHỈ dùng cho máy dev.

DB_PASSWORD=hwin_dev

# Khóa ký JWT (HS256) – tối thiểu 32 ký tự
JWT_SECRET=dev-only-change-me-0123456789abcdef-0123456789
# Pepper để băm OTP trong Redis
OTP_PEPPER=dev-only-otp-pepper-change-me

# Admin đầu tiên được tạo tự động khi khởi động (nếu chưa có).
# - Profile dev: giữ các dòng dưới là comment -> dùng admin / admin (miễn OTP, chỉ có ở dev).
# - Môi trường thật: BẮT BUỘC mật khẩu mạnh (>= 12 ký tự, có chữ và số) + nơi nhận OTP
#   (ADMIN_EMAIL là email thật, hoặc có ADMIN_PHONE), nếu không backend sẽ từ chối khởi động.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_PHONE=

# SMTP gửi OTP qua email.
# - Dev: bỏ trống -> dùng Mailpit trong compose.yaml (xem thư: http://localhost:18025).
# - Môi trường thật: BẮT BUỘC, ví dụ Gmail SMTP / SendGrid / Amazon SES; thiếu thì backend từ chối khởi động.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=Hwin Food <no-reply@hwin.vn>
# Dev muốn gửi qua SMTP thật (Gmail...) thì bật thêm 2 dòng:
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true

# Khóa AES-GCM 32 byte (base64) mã hóa số CCCD của khách – môi trường thật BẮT BUỘC đổi
# IDENTITY_PII_KEY=

# Domain frontend được phép gọi CORS
FRONTEND_ORIGIN=http://localhost:3100

# Khóa AES-GCM 32 byte (base64) mã hóa thông tin ngân hàng CTV – dùng ở Chặng 3
AFFILIATE_BANK_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktY2hhbmdlLW1lISE=

# Tài khoản nhận chuyển khoản – sinh ảnh VietQR (mã BIN ngân hàng: 970436 = Vietcombank)
BANK_QR_BIN=970436
BANK_QR_ACCOUNT=0123456789
BANK_QR_NAME=CONG TY HWIN

# SMS_PROVIDER=esms
# SMS_API_KEY=...
# SMS_SECRET_KEY=...
# SMS_BRANDNAME=HWINFOOD
# SMS_OTP_TEMPLATE=Ma xac thuc HWIN cua ban la {code}. Hieu luc 5 phut. Khong chia se ma nay cho bat ky ai.