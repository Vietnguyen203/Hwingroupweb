# Sao chép thành file .env (đã nằm trong .gitignore) rồi đổi giá trị.
# Các giá trị dưới đây CHỈ dùng cho máy dev.

DB_PASSWORD=hwin_dev

# Khóa ký JWT (HS256) – tối thiểu 32 ký tự
JWT_SECRET=dev-only-change-me-0123456789abcdef-0123456789
# Pepper để băm OTP trong Redis
OTP_PEPPER=dev-only-otp-pepper-change-me

# Admin được tạo tự động khi khởi động (nếu chưa có)
ADMIN_EMAIL=admin@hwin.local
ADMIN_PASSWORD=Admin@12345

# Domain frontend được phép gọi CORS
FRONTEND_ORIGIN=http://localhost:3100

# Khóa AES-GCM 32 byte (base64) mã hóa thông tin ngân hàng CTV – dùng ở Chặng 3
AFFILIATE_BANK_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktY2hhbmdlLW1lISE=
